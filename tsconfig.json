{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./web/src/*"]
    }
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "vitest.config.ts", "drizzle.config.ts"],
  "exclude": ["dist", "web"]
}
