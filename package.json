{
  "name": "basis-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:web && concurrently --kill-others-on-fail -n auth,client,admin \"node node_modules/tsx/dist/cli.mjs watch src/index.ts\" \"node node_modules/vite/bin/vite.js build --watch --config web/vite.config.ts\" \"node node_modules/tsx/dist/cli.mjs watch admin/index.ts\"",
    "dev:admin": "tsx watch admin/index.ts",
    "dev:auth": "tsx watch src/index.ts",
    "dev:client": "vite build --watch --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:web:admin && tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build:web:admin": "vite build --config admin/web/vite.config.ts",
    "start": "node dist/src/index.js",
    "start:admin": "node dist/admin/index.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "keys:generate": "tsx scripts/generate-jwks.ts",
    "setup": "tsx scripts/generate-jwks.ts",
    "clients:add": "tsx scripts/add-client.ts",
    "clients:remove": "tsx scripts/remove-client.ts",
    "admin:grant": "tsx scripts/admin-grant.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:check-dupes": "tsx scripts/check-dupes.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.4",
    "jdenticon": "^3.3.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.34.0",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
