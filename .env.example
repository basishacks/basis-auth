NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://basis_auth:basis_auth@localhost:5432/basis_auth
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=3001
OIDC_ISSUER=http://localhost:3000
OIDC_COOKIE_KEYS=replace-with-at-least-32-random-characters,replace-with-a-second-32-character-key

# Generate with: npm run keys:generate
# Required in production. Development generates an ephemeral key when omitted.
OIDC_JWKS_JSON=
# Alternatively, point at a mounted JSON file containing private JWKs.
# OIDC_JWKS_FILE=/run/secrets/oidc-jwks.json

OIDC_RESOURCES_JSON=[{"audience":"urn:basis:api:example","scopes":["projects.read","projects.write"]}]
OIDC_CLIENTS_JSON=[{"clientId":"basis-portal","name":"Basis Portal","clientSecret":"replace-with-a-long-random-client-secret","redirectUris":["http://localhost:4000/oauth/callback"],"public":false,"scopes":["openid","profile","email","permissions","offline_access","projects.read"],"resources":["urn:basis:api:example"],"requireConsent":true,"filterMode":null,"filterContent":[]}]
DEFAULT_PERMISSION=participant
BOOTSTRAP_PERMISSION_GRANTS_JSON=[{"email":"admin@example.edu","permissions":["admin"]}]

# Microsoft Entra tenant-specific issuer, not /common. Set all three together.
MICROSOFT_ISSUER=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Trust X-Forwarded-For only when every request passes through a proxy that
# overwrites it. Never enable on a directly exposed host.
TRUST_PROXY=false
# Interval for the expired session/token/request cleanup sweep.
PURGE_INTERVAL_MS=3600000
# Rate limiting (sliding window per client IP).
RATE_LIMIT_TOKEN_PER_MINUTE=30
RATE_LIMIT_AUTHORIZE_PER_MINUTE=60
RATE_LIMIT_INTERACTION_PER_MINUTE=120
RATE_LIMIT_CALLBACK_MAX_FAILURES=10
# Request body caps in bytes.
BODY_LIMIT_BYTES=1048576
UPLOAD_BODY_LIMIT_BYTES=6291456

# --- Management portal (separate process, npm run dev:admin) ---
# Public URL where the portal SPA is served; redirect URIs derive from it.
ADMIN_PUBLIC_URL=http://localhost:3100
ADMIN_PORT=3100
# Dedicated least-privilege role created by scripts/create-admin-role.sql.
ADMIN_DATABASE_URL=postgresql://basis_admin:basis_admin@localhost:5432/basis_auth
# The portal's own client registration inside OIDC_CLIENTS_JSON.
ADMIN_CLIENT_ID=replace-with-the-portal-client-id
ADMIN_COOKIE_KEYS=replace-with-at-least-32-random-characters,replace-with-a-second-32-character-key
STEP_UP_MAX_AGE_SECONDS=300
SESSION_TTL_HOURS=8
# Optional comma-separated IPs or IPv4 CIDR ranges allowed to reach the portal.
ADMIN_IP_ALLOWLIST=
# Optional HMAC-signed privilege-change alert webhook. Both values required together.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
